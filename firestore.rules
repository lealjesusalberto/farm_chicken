rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Función auxiliar para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar para verificar propiedad
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Función auxiliar para verificar si es administrador
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'admin@farmchicken.com';
    }

    // Reglas para la colección de usuarios
    match /users/{userId} {
      // Cualquiera autenticado puede leer (necesario para rankings, etc)
      allow read: if isAuthenticated();
      
      // Un usuario solo puede crear su propio documento al registrarse
      allow create: if isOwner(userId);
      
      // PREVENCIÓN DE VULNERABILIDAD: Evitamos que el usuario cambie su propio 'role' o 'status' a 'admin' o 'approved'.
      // Permite editar su dinero (eggBalance, etc) por ahora, porque la arquitectura del juego lo requiere.
      allow update: if isAdmin() || (isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])));
    }

    // Reglas para la colección de gallinas
    match /chickens/{chickenId} {
      // Solo el dueño puede leer sus gallinas
      allow read: if isOwner(resource.data.userId);
      
      // Solo el dueño puede crear/actualizar/eliminar gallinas vinculadas a su ID
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Reglas para la colección de transacciones (recargas y retiros)
    match /transactions/{transactionId} {
      // Solo el dueño de la transacción puede verla (y los admins)
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // PREVENCIÓN: Evitamos que cree transacciones que ya nazcan "aprobadas"
      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.status == 'pending';
                    
      // EL CLIENTE NO PUEDE ACTUALIZAR NI ELIMINAR TRANSACCIONES
      // Así evitamos que el jugador abra la consola y cambie su estado a 'approved' para darse dinero infinito.
      allow update, delete: if isAdmin(); 
    }

    // Reglas para datos globales (clima)
    match /global/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }

    // Reglas para datos de configuración (oráculo)
    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }
  }
}
